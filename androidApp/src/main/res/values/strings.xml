    <string name="guide_starting_title">启动本地代理</string>
    <string name="guide_starting_body">正在启动后台会话，准备接收游戏存档。</string>
    <string name="guide_auto_title">自动设置代理</string>
    <string name="guide_auto_body">正在通过 Shizuku 设置系统代理，完成后会自动验证连接。</string>
    <string name="guide_manual_title">连接本地代理</string>
    <string name="guide_manual_body">本地代理已启动。请为当前 Wi-Fi 设置代理，保存后返回这里，应用会自动检测。</string>
    <string name="guide_manual_instructions">1. 打开 Wi-Fi 设置，进入已连接网络的详情或修改网络。\n\n2. 展开高级选项，将“代理”改为“手动”。\n\n3. 填入下方主机名和端口，其他选项保持原样，然后保存。</string>
    <string name="guide_host_value">主机名：127.0.0.1</string>
    <string name="guide_port_value">端口：8888</string>
    <string name="guide_wifi_required">手动设置需要连接 Wi-Fi；已授权的 Shizuku 也可以自动设置代理。</string>
    <string name="guide_wifi_settings">打开 Wi-Fi 设置</string>
    <string name="guide_verify">检测代理连接</string>
    <string name="guide_verify_again">重新检测连接</string>
